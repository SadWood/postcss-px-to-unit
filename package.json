{
  "name": "postcss-px-to-unit",
  "version": "3.3.2",
  "description": "A postcss plugin to convert px to relative length units (vw / vh / rem)",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "node ./test/dev.js",
    "bench": "node ./scripts/benchmark.js",
    "test": "jest ./test --coverage",
    "prepublishOnly": "pnpm test"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "postcss",
    "px2rem",
    "px2vw",
    "px2vh",
    "rem",
    "vh",
    "viewport"
  ],
  "author": "SadWood",
  "license": "MIT",
  "devDependencies": {
    "jest": "^27.5.1",
    "postcss": "^8.4.7",
    "prettier": "2.5.1",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0"
  },
  "peerDependencies": {
    "postcss": "^8.4.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SadWood/postcss-px-to-unit"
  }
}
