{
  "name": "postcss-px-to-unit",
  "version": "3.5.2",
  "description": "A postcss plugin to convert px to relative length units (vw / vh / rem)",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "^18.14.0 || ^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node ./test/dev.js",
    "bench": "node ./scripts/benchmark.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js ./test --coverage",
    "type-check": "tsc -p tsconfig.types.json",
    "verify:package": "node ./scripts/verify-package.js",
    "prepublishOnly": "pnpm test && pnpm type-check && pnpm verify:package"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "postcss",
    "px2rem",
    "px2vw",
    "px2vh",
    "rem",
    "vh",
    "viewport"
  ],
  "author": "SadWood",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.4.2",
    "postcss": "^8.5.15",
    "prettier": "3.8.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "postcss": "^8.4.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SadWood/postcss-px-to-unit"
  },
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  }
}
